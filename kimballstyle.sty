%%% Theorem environments
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{falselemma}[theorem]{\textcolor{red}{False Lemma}}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{conjecture}{Conjecture}
\newtheorem*{nonumtheorem}{Theorem}
% Alphabetical theorems for clarity
\newtheorem{alphatheorem}{Theorem}
\renewcommand{\thealphatheorem}{\Alph{alphatheorem}}
% Multi part theorems for fanciness
\newtheorem*{theoremB1}{Theorem B1}
\newtheorem*{theoremB2}{Theorem B2}
\theoremstyle{definition}
\newtheorem*{nonumdefinition}{Definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem*{pseudo-definition}{Pseudo-Definition}
\newtheorem{example}[theorem]{Example}
\theoremstyle{remark}
\newtheorem*{remark}{Remark}


